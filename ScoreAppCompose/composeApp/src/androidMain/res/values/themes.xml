<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色纸面风格：无 ActionBar，状态栏与页面同色并启用深色图标 -->
    <style name="Theme.ScoreApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
